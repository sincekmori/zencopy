{
  "name": "zencopy",
  "version": "0.8.1",
  "private": true,
  "license": "Apache-2.0",
  "author": "Shinsuke Mori",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "brand": "tauri icon src/assets/zencopy-icon.svg -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios && bun run --cwd site brand",
    "dev-reset": "bun scripts/dev-reset.ts",
    "dev-usage": "bun scripts/dev-usage.ts",
    "lint": "oxlint --deny-warnings && bun run --cwd site lint",
    "lint:fix": "oxlint --fix",
    "lint:dead": "knip",
    "lint:toml": "tombi lint --error-on-warnings",
    "format": "oxfmt && bun run --cwd site format",
    "format:check": "oxfmt --check && bun run --cwd site format:check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ai": "^7.0.37",
    "ai-sdk-catalog": "^0.10.1",
    "ai-sdk-ping": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "franc-min": "^6.2.0",
    "liquidjs": "^10.27.2",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-import-zod": "^1.2.1",
    "knip": "^6.29.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tailwindcss": "^1.6.0",
    "tailwindcss": "^4.3.3",
    "tombi": "^1.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "@ai-sdk/provider": "4.0.3",
    "@ai-sdk/provider-utils": "5.0.12"
  }
}
