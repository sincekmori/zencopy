---
/**
 * A screenshot of the app for the docs, in the visitor's OS. `bun run
 * screenshot` (scripts/screenshot.ts) shoots every scenario as a visitor of
 * unknown OS (<name>.png, the key chord spelled Ctrl/⌘) and, where the
 * picture carries the chord (the `os` flag in src/lib/screenshot-scenarios.ts,
 * which the runner checks against the renders), as Windows (<name>.ctrl.png,
 * Ctrl + C + C) and macOS (<name>.cmd.png, ⌘ + C + C) too; the head script
 * (astro.config.mjs) swaps the source by OS, as it does for the demo videos —
 * as the parser adds the picture, and the picture loads lazily, so the swap
 * comes before the fetch and only the visitor's own cut is downloaded.
 * The picture is the window at its own size — the scenario's viewport in
 * logical px, one PNG pixel each, written as the image's width and height
 * so the page lays it out before it loads — as big on the page as the
 * window is on the screen, shrinking only where the column is narrower.
 * The locale is the page's; the alt text is the page's own words.
 */
import {
  SCREENSHOT_SCENARIOS,
  viewportOf,
} from "../../../src/lib/screenshot-scenarios.ts";
import { pageLocale } from "../lib/page-locale.ts";

interface Props {
  name: string;
  alt: string;
}
const { name, alt } = Astro.props;
const scenario = SCREENSHOT_SCENARIOS[name];
if (scenario === undefined) {
  throw new Error(
    `no screenshot scenario "${name}" — see src/lib/screenshot-scenarios.ts`,
  );
}
const { locale } = pageLocale(Astro.locals);
const base = `/${locale}/screenshots/${name}`;
const { width, height } = viewportOf(scenario);
---

<img
  alt={alt}
  data-src-cmd={scenario.os ? `${base}.cmd.png` : undefined}
  data-src-ctrl={scenario.os ? `${base}.ctrl.png` : undefined}
  height={height}
  loading="lazy"
  src={`${base}.png`}
  width={width}
/>
