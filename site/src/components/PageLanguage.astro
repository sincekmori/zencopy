---
/**
 * The name of the page's own language, in that language — 日本語 on a ja
 * page, English on an en page — from the locale, so prose that says "into
 * your language" is written once and stays true in every translation. The
 * ja source (the reference the other locales are translated from) uses it
 * wherever it means the reader's language.
 */
import { pageLocale } from "../lib/page-locale.ts";

const { lang } = pageLocale(Astro.locals);
const name =
  new Intl.DisplayNames([lang], { type: "language" }).of(lang) ?? lang;
---

<span>{name}</span>
