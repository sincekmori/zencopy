---
/** Renders the docs architecture diagram in the page's language.
 *  Labels come from the per-locale table in architecture-labels.ts (a page
 *  whose locale has no entry gets the default locale's) and the markup from
 *  architectureDiagram(), a pure function of those labels — see
 *  architecture-diagram.ts for the layout rules. RTL locales mirror
 *  automatically. */
import { DEFAULT_LOCALE, pageLocale } from "../lib/page-locale.ts";
import { architectureDiagram } from "./architecture-diagram.ts";
import {
  ARCHITECTURE_LABELS,
  RTL_ARCHITECTURE_LOCALES,
  type ArchitectureLocale,
} from "./architecture-labels.ts";

const labeled = (locale: string): locale is ArchitectureLocale =>
  locale in ARCHITECTURE_LABELS;
const page = pageLocale(Astro.locals).locale;
const locale = labeled(page) ? page : DEFAULT_LOCALE;
const dir = RTL_ARCHITECTURE_LOCALES.has(locale) ? "rtl" : "ltr";
---

<Fragment set:html={architectureDiagram(ARCHITECTURE_LABELS[locale], dir)} />
