---
/**
 * The zencopy.app landing page — a fully custom page outside the Starlight
 * shell (docs keep Starlight; this route overrides only `/` and `/ja/`).
 * Design language: ink on paper, hairline rules, one motif (the brand's two
 * arcs, drawn like an enso stroke), and room to breathe. No boxes, no cards.
 * Theme state is shared with Starlight via the same localStorage key.
 */
import { getEntry } from "astro:content";
import HeroDemo from "./HeroDemo.astro";
import { LANDING_COPY, LANDING_LOCALES, THEME_LABELS } from "./landing-copy.ts";

interface Props {
  /** One of the codes in LANDING_LOCALES (e.g. "en", "ja", "zh-hans"). */
  lang: string;
}

const { lang } = Astro.props;

const locale = LANDING_LOCALES.find((entry) => entry.code === lang);
const copy = LANDING_COPY[lang];
const theme = THEME_LABELS[lang];
if (!locale || !copy || !theme) {
  throw new Error(`Landing: unknown locale "${lang}"`);
}

// The CTA is labeled with the getting-started guide's own frontmatter title,
// read at build time — the button and the page it opens can never drift apart,
// in any locale.
const guide = await getEntry("docs", `${lang}/getting-started`);
if (!guide) {
  throw new Error(`Landing: no getting-started guide for "${lang}"`);
}
const getStarted = guide.data.title;

const github = "https://github.com/sincekmori/zencopy";
const canonical = `https://zencopy.app/${lang}/`;
const gettingStartedHref = `/${lang}/getting-started/`;
---

<html dir={locale.dir} lang={locale.lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{copy.metaTitle}</title>
    <meta content={copy.description} name="description" />
    <link href={canonical} rel="canonical" />
    {
      LANDING_LOCALES.map((entry) => (
        <link
          href={`https://zencopy.app/${entry.code}/`}
          hreflang={entry.lang}
          rel="alternate"
        />
      ))
    }
    <link href="https://zencopy.app/" hreflang="x-default" rel="alternate" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
    <link href="/sitemap-index.xml" rel="sitemap" />
    <meta content="ZenCopy" property="og:site_name" />
    <meta content={copy.metaTitle} property="og:title" />
    <meta content={copy.description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={canonical} property="og:url" />
    <meta content="https://zencopy.app/og.png" property="og:image" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta
      content="ZenCopy — Copy twice, act instantly. Talk to an AI anywhere."
      property="og:image:alt"
    />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="https://zencopy.app/og.png" name="twitter:image" />
    {
      /* Theme before first paint — same key Starlight uses, so the choice
        follows the visitor between the landing page and the docs. */
    }
    <script is:inline>
      (() => {
        let stored;
        try {
          stored = localStorage.getItem("starlight-theme");
        } catch {
          /* storage unavailable — fall through to the media query */
        }
        const dark =
          stored === "dark" ||
          (stored !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <a aria-label="ZenCopy" class="brand" href={`/${lang}/`}>
        <svg
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M12.22 3.39A6.5 6.5 0 0 0 3.89 11.72"></path>
          <path d="M20.32 10.77A6.5 6.5 0 1 0 20.32 18.23"></path>
        </svg>
        <span>ZenCopy</span>
      </a>
      <nav>
        <a href={gettingStartedHref}>{copy.docs}</a>
        <a href={github}>GitHub</a>
        {
          /* Language and theme use the same control the docs header uses
            (Starlight's icon + select + caret), so the whole site speaks one
            visual language. One selector replaces 18 links; JS-off visitors
            still get the full list as plain links on the bare-domain page. */
        }
        <label class="select">
          <svg
            aria-hidden="true"
            class="label-icon"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              clip-rule="evenodd"
              d="M8.516 3a.94.94 0 0 0-.941.94v1.15H2.94a.94.94 0 1 0 0 1.882h7.362a7.422 7.422 0 0 1-1.787 3.958 7.42 7.42 0 0 1-1.422-2.425.94.94 0 1 0-1.774.627 9.303 9.303 0 0 0 1.785 3.043 7.422 7.422 0 0 1-4.164 1.278.94.94 0 1 0 0 1.881 9.303 9.303 0 0 0 5.575-1.855 9.303 9.303 0 0 0 4.11 1.74l-.763 1.525a.968.968 0 0 0-.016.034l-1.385 2.77a.94.94 0 1 0 1.683.841l1.133-2.267h5.806l1.134 2.267a.94.94 0 0 0 1.683-.841l-1.385-2.769a.95.95 0 0 0-.018-.036l-3.476-6.951a.94.94 0 0 0-1.682 0l-1.82 3.639a7.423 7.423 0 0 1-3.593-1.256 9.303 9.303 0 0 0 2.27-5.203h1.894a.94.94 0 0 0 0-1.881H9.456V3.94A.94.94 0 0 0 8.516 3Zm6.426 11.794a1.068 1.068 0 0 1-.02.039l-.703 1.407h3.924l-1.962-3.924-1.24 2.478Z"
              fill-rule="evenodd"></path>
          </svg>
          <select aria-label="Language" id="lang">
            {
              LANDING_LOCALES.map((entry) => (
                <option
                  lang={entry.lang}
                  selected={entry.code === lang}
                  value={entry.code}
                >
                  {entry.label}
                </option>
              ))
            }
          </select>
          <svg
            aria-hidden="true"
            class="caret"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"
            ></path>
          </svg>
        </label>
        <label class="select">
          <svg
            aria-hidden="true"
            class="label-icon"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"
            ></path>
          </svg>
          <select aria-label="Theme" id="theme">
            <option value="auto">{theme.system}</option>
            <option value="light">{theme.light}</option>
            <option value="dark">{theme.dark}</option>
          </select>
          <svg
            aria-hidden="true"
            class="caret"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"
            ></path>
          </svg>
        </label>
      </nav>
    </header>

    <main>
      <section class="hero">
        {/* The brand's two arcs, drawn like a single brush stroke. */}
        <svg
          aria-hidden="true"
          class="enso"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <path d="M12.22 3.39A6.5 6.5 0 0 0 3.89 11.72" pathLength="1"></path>
          <path d="M20.32 10.77A6.5 6.5 0 1 0 20.32 18.23" pathLength="1"
          ></path>
        </svg>
        <h1>
          {
            copy.heroTitle
              .split("\n")
              .map((line) => <span class="line">{line}</span>)
          }
        </h1>
        {
          /* One door for the one audience this page has — first-time
            visitors (installed copies update themselves). The CTA carries
            the guide's own name and opens it: the download lives there,
            next to the steps that make sense of it. */
        }
        <div class="cta">
          <a class="primary" href={gettingStartedHref}>{getStarted}</a>
        </div>
        <p class="note">{copy.note}</p>
      </section>

      {/* The loop shows it; the caption says it — once, for the whole page. */}
      <section aria-label={copy.demoAria} class="demo">
        <figure>
          <HeroDemo />
          <figcaption>{copy.demoCaption}</figcaption>
        </figure>
      </section>

      <section class="features">
        {
          copy.features.map((feature) => (
            <article>
              <h2>{feature.title}</h2>
              <p>{feature.body}</p>
            </article>
          ))
        }
      </section>

      <section class="philosophy">
        <p class:list={{ ja: lang === "ja" }}>{copy.philosophy}</p>
      </section>
    </main>

    <footer>
      <a href={`/${lang}/privacy/`}>{copy.privacyLabel}</a>
      <span>·</span>
      <a href={`/${lang}/terms/`}>{copy.termsLabel}</a>
      <span>·</span>
      <a href={github}>GitHub</a>
      <span>·</span>
      <span>Apache-2.0 © Shinsuke Mori</span>
    </footer>

    {/* The visitor's own modifier key, when the OS is known. */}
    <script is:inline>
      (() => {
        const ua = navigator.userAgent;
        const isMac = /Mac|iP(hone|ad|od)/u.test(ua);
        const isDesktopLinux = /Linux|X11/u.test(ua) && !/Android/u.test(ua);
        if (!isMac && !isDesktopLinux && !/Windows/u.test(ua)) {
          return;
        }
        for (const el of document.querySelectorAll("[data-os-modifier]")) {
          el.textContent = isMac ? "⌘" : "Ctrl";
        }
      })();
    </script>
    {
      /* The language selector navigates to the same page in the chosen locale. */
    }
    <script is:inline>
      // Both selects are sized to the label they currently show — a native
      // select's auto width fits its widest option, which would leave a gap
      // before the caret when the current label is short. The theme select is
      // re-fit when its label swaps in place; no-JS keeps the intrinsic width.
      const fitSelect = (sel) => {
        const opt = sel.selectedOptions[0];
        if (!opt) {
          return;
        }
        const cs = getComputedStyle(sel);
        const probe = document.createElement("span");
        probe.style.font = cs.font;
        probe.style.visibility = "hidden";
        probe.style.position = "absolute";
        probe.style.whiteSpace = "pre";
        probe.textContent = opt.textContent.trim();
        document.body.append(probe);
        const text = probe.getBoundingClientRect().width;
        probe.remove();
        // Computed styles carry a "px" suffix, so Number() would yield NaN —
        // parseFloat is the right tool here.
        // oxlint-disable-next-line unicorn/prefer-number-coercion
        const pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
        sel.style.width = `${Math.ceil(text + pad) + 1}px`;
      };
      for (const sel of document.querySelectorAll("label.select > select")) {
        fitSelect(sel);
        sel.addEventListener("change", () => fitSelect(sel));
      }
      document.getElementById("lang").addEventListener("change", (event) => {
        location.href = `/${event.target.value}/`;
      });
    </script>
    {
      /* Theme select — same auto/light/dark values and storage key Starlight
        uses, so the choice carries between the landing page and the docs. */
    }
    <script is:inline>
      const applyTheme = (value) => {
        const dark =
          value === "dark" ||
          (value !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      };
      (() => {
        const sel = document.getElementById("theme");
        let stored;
        try {
          stored = localStorage.getItem("starlight-theme");
        } catch {
          /* storage unavailable — fall back to auto for this page */
        }
        sel.value = stored === "light" || stored === "dark" ? stored : "auto";
        sel.addEventListener("change", () => {
          applyTheme(sel.value);
          try {
            localStorage.setItem("starlight-theme", sel.value);
          } catch {
            /* storage unavailable — the choice still applies for this page */
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(:root) {
    --paper: #fcfcfc;
    --ink: #18181b;
    --ink-soft: #52525b;
    --ink-faint: #a1a1aa;
    --hairline: rgb(24 24 27 / 0.12);
    color-scheme: light;
  }
  :global(:root[data-theme="dark"]) {
    --paper: #111113;
    --ink: #f4f4f5;
    --ink-soft: #a1a1aa;
    --ink-faint: #52525b;
    --hairline: rgb(244 244 245 / 0.16);
    color-scheme: dark;
  }

  :global(*, *::before, *::after) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      "Hiragino Sans",
      "Yu Gothic UI",
      sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: background-color 200ms ease;
  }
  a {
    color: inherit;
    text-decoration: none;
  }

  /* ——— header ——— */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .brand svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  /* Never let a nav item squeeze into vertical text: each keeps its width;
    when they cannot all fit (narrow screens) the text links are hidden
    below, not mangled. */
  nav > a,
  nav > .select {
    flex-shrink: 0;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--ink);
  }
  /* Language and theme controls, matched to the docs header (Starlight's
    select): the function icon and the caret sit inside the select's own
    padding, so the label and chevron stay tight — one look across the site. */
  .select {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
  }
  .select:hover {
    color: var(--ink);
  }
  .select > select {
    appearance: none;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    padding-block: 0.3rem;
    padding-inline: 1.55rem 1.4rem;
    text-overflow: ellipsis;
  }
  .select > select:focus-visible {
    outline: 2px solid var(--ink-faint);
    outline-offset: 1px;
  }
  .select .label-icon,
  .select .caret {
    position: absolute;
    top: 50%;
    width: 1rem;
    height: 1rem;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .select .label-icon {
    inset-inline-start: 0.3rem;
  }
  .select .caret {
    inset-inline-end: 0.15rem;
  }
  /* Width comes from the fit-to-selected script below (a native select's
    auto width fits its widest option, leaving a gap before the caret when
    the current label is short). No-JS keeps the intrinsic width. */

  /* ——— hero ——— */
  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(5rem, 14vh, 9rem) 0 clamp(4rem, 10vh, 7rem);
  }
  .enso {
    width: clamp(4.5rem, 10vw, 6rem);
    height: clamp(4.5rem, 10vw, 6rem);
    stroke-width: 1.1;
    color: var(--ink);
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .enso path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .enso path + path {
      animation-delay: 0.55s;
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }
  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    font-weight: 250;
    letter-spacing: -0.015em;
    line-height: 1.18;
  }
  h1 .line {
    display: block;
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .primary {
    padding: 0.7rem 2rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    transition: opacity 150ms ease;
  }
  .primary:hover {
    opacity: 0.85;
  }
  .note {
    margin: 1.75rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  /* ——— demo ——— */
  .demo {
    max-width: 52rem;
    margin: 0 auto;
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }
  .demo figure {
    margin: 0;
  }
  .demo figcaption {
    max-width: 34rem;
    margin: 1.75rem auto 0;
    font-size: 0.95rem;
    text-align: center;
    color: var(--ink-soft);
  }

  /* ——— features ——— */
  .features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 5rem;
    padding: clamp(3rem, 8vh, 5rem) 0;
    max-width: 52rem;
    margin: 0 auto;
  }
  .features article {
    padding: 2.25rem 0;
    border-top: 1px solid var(--hairline);
  }
  .features article:nth-child(-n + 2) {
    border-top: 0;
  }
  .features h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }
  .features p {
    margin: 0.75rem 0 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  /* ——— philosophy ——— */
  .philosophy {
    display: flex;
    justify-content: center;
    padding: clamp(4rem, 12vh, 8rem) 0;
  }
  .philosophy p {
    margin: 0;
    max-width: 30rem;
    font-family: ui-serif, Georgia, "Hiragino Mincho ProN", "Yu Mincho", serif;
    font-size: 1.15rem;
    font-style: italic;
    text-align: center;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
  /* Italic serif reads as quotation in Latin script but looks broken in
     Japanese — keep the typeface, drop the slant, let the spacing breathe. */
  .philosophy p.ja {
    font-style: normal;
    letter-spacing: 0.2em;
  }

  /* ——— footer ——— */
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 64rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  footer a:hover {
    color: var(--ink);
  }

  /* ——— small screens ——— */
  @media (max-width: 40rem) {
    .top {
      padding-inline: 1rem;
    }
    nav {
      gap: 0.75rem;
    }
    /* Declutter the header to brand + the two controls. Docs is one tap away
      via the hero's "Get started →"; GitHub lives in the footer. */
    nav > a {
      display: none;
    }
    .features {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .features article:nth-child(2) {
      border-top: 1px solid var(--hairline);
    }
  }
</style>
