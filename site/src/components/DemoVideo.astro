---
// One demo video embed for the docs pages. Every locale has its own demos
// (/public/<locale>/demo/<demo>.mp4 with a matching .jpg poster), generated
// by `bun run demo-video` (scripts/demo-video.ts) — the popup in the video
// speaks the page's language, so the locale is the page's (the default
// locale's outside a Starlight route), not a prop; recording a locale is
// part of adding one (see AGENTS.md). What a demo plays over and the frame
// it is filmed in are the generator's declarations
// (scripts/demo-video/demos.ts): the mail page with the popup beside it
// (landscape, shown at the column's full width), or the popup window alone
// (portrait, capped narrower). The slot is the localized fallback link text
// for browsers that cannot play the video.
//
// A captioned demo (scripts/demo-video/captions.ts) whose lines name the key
// chord comes as two videos: the default says Ctrl + C + C, the `.mac` one
// ⌘ + C + C, and the head script (astro.config.mjs) swaps the source to the
// latter on a Mac — the same progressive enhancement as the OS wording.
import { CAPTIONS, namesChord } from "../../../scripts/demo-video/captions.ts";
import {
  DEMOS,
  FRAMES,
  VIDEO_SCALE,
} from "../../../scripts/demo-video/demos.ts";
import { pageLocale } from "../lib/page-locale.ts";

interface Props {
  demo: string;
}
const { demo } = Astro.props;
const declared = DEMOS.find((entry) => entry.name === demo);
if (declared === undefined) {
  throw new Error(`no demo named "${demo}" — see scripts/demo-video/demos.ts`);
}
const { locale } = pageLocale(Astro.locals);
const base = `/${locale}/demo/${demo}`;
const wide = declared.stage === "page";
const frame = FRAMES[declared.stage];
const width = frame.width * VIDEO_SCALE;
const height = frame.height * VIDEO_SCALE;
const lines = CAPTIONS[locale]?.[demo];
const mac = lines !== undefined && namesChord(lines);
---

<video
  class:list={["demo-video", { wide }]}
  controls
  data-mac-src={mac ? `${base}.mac.mp4` : undefined}
  height={height}
  muted
  playsinline
  poster={`${base}.jpg`}
  preload="metadata"
  src={`${base}.mp4`}
  width={width}
>
  <a href={`${base}.mp4`}><slot /></a>
</video>
