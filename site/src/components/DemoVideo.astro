---
// One demo video embed for the docs pages. Demos are portrait screen captures
// (/public/<locale>/demo/<demo>.mp4 with a matching .jpg poster), so the
// dimensions live here, once. Only the locales in RECORDED have their own
// recordings; every other locale serves the English one — the app in the
// video just speaks English there. The slot is the localized fallback link
// text for browsers that cannot play the video.
const RECORDED = ["en", "ja"];
interface Props {
  demo: "auto" | "summarize";
  locale: string;
}
const { demo, locale } = Astro.props;
const base = `/${RECORDED.includes(locale) ? locale : "en"}/demo/${demo}`;
---

<video
  class="demo-video"
  controls
  height="2262"
  muted
  playsinline
  poster={`${base}.jpg`}
  preload="metadata"
  src={`${base}.mp4`}
  width="1748"
>
  <a href={`${base}.mp4`}><slot /></a>
</video>
