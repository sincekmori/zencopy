{
  "name": "zencopy-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "lint": "eslint --max-warnings 0 . && astro check",
    "format": "prettier --write \"src/**/*.astro\"",
    "format:check": "prettier --check \"src/**/*.astro\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.4.2",
    "rehype-external-links": "^3.0.0",
    "remark-custom-heading-id": "^2.0.0",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6",
    "wrangler": "^4.152.0"
  }
}
