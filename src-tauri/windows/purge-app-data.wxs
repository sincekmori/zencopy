<?xml version="1.0" encoding="utf-8"?>
<!--
  Purge per-user state when ZenCopy is uninstalled via the MSI: the config +
  data dir (Roaming) and the local-data dir (logs, the WebView2 profile,
  caches) — the same set scripts/dev-reset.ts deletes. The NSIS installer has
  its own "Delete the application data" checkbox; MSI has no such UI, so this
  fragment does it unconditionally on a REAL uninstall only.

  The Installed AND NOT UPGRADINGPRODUCTCODE condition is load-bearing: a
  version upgrade uninstalls the old product first, and without the guard
  every update would wipe the user's settings.

  The autostart Run registry value (written at runtime, not by the MSI) is
  deliberately left behind: MSI can only remove foreign registry values at
  install time, and Windows ignores Run entries whose target is gone.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <SetProperty Id="PURGEROAMINGDIR" Value="[AppDataFolder]app.zencopy" After="CostInitialize">
      Installed AND NOT UPGRADINGPRODUCTCODE
    </SetProperty>
    <SetProperty Id="PURGELOCALDIR" Value="[LocalAppDataFolder]app.zencopy" After="CostInitialize">
      Installed AND NOT UPGRADINGPRODUCTCODE
    </SetProperty>
    <DirectoryRef Id="TARGETDIR">
      <!-- The HKCU value exists only as the component's required key path and
           is removed by the MSI itself on uninstall. -->
      <Component Id="PurgeAppData" Guid="2D70D43E-1E1D-45D0-9843-FA1CA2778380">
        <RegistryValue Root="HKCU" Key="Software\app.zencopy" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <util:RemoveFolderEx On="uninstall" Property="PURGEROAMINGDIR" />
        <util:RemoveFolderEx On="uninstall" Property="PURGELOCALDIR" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
